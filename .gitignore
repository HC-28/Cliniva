# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
application-secret.yml
application-secret.properties

# Java / Maven / IDE output
target/
out/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
mvnw.cmd.log

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# IDE & Editor files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Documents & Temp files
*.docx
~$*.docx

# Logs & Storage
*.log
logs/
cliniva-uploads/
scratch/
.system_generated/

# Testing & Coverage
coverage/
*.lcov
.nyc_output
