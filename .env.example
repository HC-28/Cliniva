# ── DATABASE CONFIGURATION ───────────────────────────────────────
CLINIVA_DB_URL=jdbc:postgresql://localhost:5432/cliniva_db
CLINIVA_DB_USER=postgres
CLINIVA_DB_PASSWORD=YOUR_DB_PASSWORD_HERE

# ── SPRING BOOT CONFIGURATION ────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ── SECURITY & JWT ───────────────────────────────────────────
CLINIVA_JWT_SECRET=YOUR_SECURE_256BIT_SECRET_KEY_HERE
CLINIVA_JWT_EXPIRATION_SECONDS=3600
CLINIVA_JWT_REFRESH_EXPIRATION_SECONDS=604800

CLINIVA_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
CLINIVA_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# ── GMAIL SMTP SERVICE (Optional) ───────────────────────────
CLINIVA_MAIL_HOST=smtp.gmail.com
CLINIVA_MAIL_PORT=587
CLINIVA_MAIL_USERNAME=YOUR_EMAIL@gmail.com
CLINIVA_MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# ── LOCAL FILE STORAGE ───────────────────────────────────────
CLINIVA_UPLOAD_DIR=./cliniva-uploads
CLINIVA_MAX_FILE_SIZE=10MB
